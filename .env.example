# Admin panel (Jobs & Agents tab, scheduler, advisor APIs). Off = shipped product (Chart only).
# NAKSHATRA_ADMIN=1

# Geocoding: offline by default (bundled cities + lat,lon). Opt in for Nominatim fallback:
# NAKSHATRA_ALLOW_ONLINE_GEOCODE=1

# Chart advisor agent (LangGraph) — Grok is loaded from workspace lang-chain-system/.env
# or set here to override:
# XAI_API_KEY=xai-...
# MODEL_NAME=grok-3-mini-fast

# Alternatives:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...

# Cursor SDK — used by launcher/index.ts
CURSOR_API_KEY=...

# Google OAuth 2.0 — download from Google Cloud Console
# (OAuth client ID for a Desktop application)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# SMTP — transit alert emails (Jobs tab)
# Gmail: use an App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your@gmail.com
SMTP_USE_TLS=1
